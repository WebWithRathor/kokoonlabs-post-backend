PORT=8080
MONGO_CONNECTION_STRING=mongodb://localhost:27017/kokoonlabs
NODE_ENV=development
CORS_ORIGIN=[http://localhost:3000 , http://192.168.10.198:3000, https://zh541kbf-3000.inc1.devtunnels.ms`, http://localhost:3001,http://localhost:5173,http://localhost:5174,http://localhost:4173]

# LMS background jobs + notification emails
ENABLE_JOBS=true
APP_BASE_URL=http://localhost:3000
# Email via Resend (leave empty to keep emails queued as pending)
RESEND_API_KEY=
EMAIL_FROM="Kokoon Labs <hello@yourdomain.com>"

# VdoCipher video playback (server-side OTP)
VDOCIPHER_API_SECRET=
VDOCIPHER_OTP_TTL=300
# Faint moving watermark with the student's ID (never their name)
VDOCIPHER_WATERMARK=false

# Kokoon IoT Studio (boards, MQTT dashboards). Off unless "true"; when on, every
# value below is checked at start and a bad one stops the server.
IOT_INTEGRATION_ENABLED=false
# IoT Studio's API, INCLUDING its API base path: http://<host>:<IoT Studio's PORT><API_BASE_PATH>.
# Requests are signed over this path: without /api/v1 every call fails. https in production.
# The server logs "IoT Studio integration OK" (or the exact problem) shortly after it starts.
IOT_STUDIO_API_URL=http://localhost:4004/api/v1
# IoT Studio's web app (its FRONTEND_URL, where "Open in IoT Studio" lands); give it a
# different port from the LMS frontend
IOT_STUDIO_APP_URL=http://localhost:5180
# HS256 key for SSO tokens: at least 48 characters, exactly the same as IoT Studio's LMS_SSO_SECRET
LMS_SSO_SECRET=
# HMAC key for server-to-server calls: at least 48 characters, different from LMS_SSO_SECRET,
# exactly the same as IoT Studio's LMS_API_SECRET
LMS_API_SECRET=
# Encrypts boards' MQTT passwords at rest: 32 bytes as 64 hex characters or base64
# (e.g. `openssl rand -hex 32`). Changing it makes boards ask IoT Studio for a new login.
IOT_CREDENTIALS_KEY=
# Optional: PEM file of the broker's CA, given to boards that connect over TLS (mqtts)
IOT_STUDIO_MQTT_CA_FILE=
